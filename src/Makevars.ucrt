# 1. Explicitly define Rtools directory so PATH doesn't break
RTOOLS_DIR_RAW = $(shell $(R_HOME)/bin/Rscript -e "cat( Sys.getenv(paste('RTOOLS',version[['major']],unlist(strsplit(x=version[['minor']],fixed = T, split = '.'))[1], '_HOME', sep='')) )")
RTOOLS_DIR = $(subst \,/,$(RTOOLS_DIR_RAW))

NPROC ?= $(shell nproc)
GCC_VER ?= $(shell gcc -dumpversion | tr -d '[:space:]')

# 2. Disable R's internal compilation of your C++ files
SOURCES = 
OBJECTS = run_cmake_superbuild.o

export PATH := $(CURDIR)/../BUILD/ncbi-cxx-toolkit-public/BUILD/bin:$(PATH)

PKG_CPPFLAGS = -DARROW_STATIC -DPARQUET_STATIC -DLIBICONV_STATIC 

CXX_STD = CXX20

# 3. The Superbuild trigger
run_cmake_superbuild.o:
	mkdir -p ../BUILD && cd ../BUILD && \
	export PATH="$(RTOOLS_DIR)/x86_64-w64-mingw32.static.posix/bin:$(RTOOLS_DIR)/usr/bin:$$PATH" && \
	unset CC && unset CXX && \
	cmake .. -G "MSYS Makefiles" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_COMPILER=gcc.exe \
		-DCMAKE_CXX_COMPILER=g++.exe \
		-DR_SHELL=1 \
		-DWIN32=1 \
		-DGCC_VER=$(GCC_VER) \
		-DRTOOLS_DIR="$(RTOOLS_DIR)" \
		-DR_INCLUDE_DIR="$(R_INCLUDE_DIR)" \
		-DCMAKE_EXPORT_NO_PACKAGE_REGISTRY=ON \
		-DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF \
		-DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF && \
	$(MAKE) -j $(NPROC)
	touch $@

# 4. Copy the compiled DLL to where R expects it
SHLIB_LINK = if [ -f ../BUILD/libQuickBLAST.dll ]; then $(STRIP) -S ../BUILD/libQuickBLAST.dll && cp ../BUILD/libQuickBLAST.dll $@; elif [ -f ../BUILD/QuickBLAST.dll ]; then $(STRIP) -S ../BUILD/QuickBLAST.dll && cp ../BUILD/QuickBLAST.dll $@; fi; echo "Linked via CMake"

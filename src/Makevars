RCPP_FOLDER = $(shell $(R_HOME)/bin/Rscript -e "cat(system.file(package='Rcpp'))")
RCPPPROG_FOLDER = $(shell $(R_HOME)/bin/Rscript -e "cat(system.file(package='RcppProgress'))")
RCPPTHREAD_FOLDER = $(shell $(R_HOME)/bin/Rscript -e "cat(system.file(package='RcppThread'))")
# We use --verbose so ld doesn't complain about "no input files" and returns 0 if found
BOOST_LIBS = $(shell ld -lboost_system --verbose > /dev/null 2>&1 && echo "-lboost_system")
STDCPPFS_LIBS = $(shell ld -lstdc++fs --verbose > /dev/null 2>&1 && echo "-lstdc++fs")


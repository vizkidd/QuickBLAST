CXX_STD = CXX20

# Adjust these paths based on where Make is executed. 
# Assuming Make runs in src/, so we step back to the package root.
PKG_ROOT = ..
MAIN_LIB = src/QuickBLAST.so
LIB_DIR = inst/libs

PKG_CFLAGS = -DARROW_STATIC -DPARQUET_STATIC -DLIBICONV_STATIC 
PKG_CPPFLAGS = -DARROW_STATIC -DPARQUET_STATIC -DLIBICONV_STATIC 

# FIX: Removed the outer double quotes from this definition
TOOLKIT_CPPFLAGS = $(CLINK_CPPFLAGS) $(PKG_CPPFLAGS)

# Evaluate external libraries safely via the OS shell using backticks instead of GNU $(shell)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) `ld -lstdc++fs --verbose > /dev/null 2>&1 && echo "-lstdc++fs"` `ld -lboost_system --verbose > /dev/null 2>&1 && echo "-lboost_system"` $(TOOLKIT_CPPFLAGS) -Wl,-rpath,\$$ORIGIN -Wl,-rpath,@loader_path/ -L../BUILD/arrow/cpp/BUILD/release/ -L../BUILD/arrow/cpp/BUILD/lib/ -L../BUILD/ncbi-cxx-toolkit-public/BUILD/lib/ -L/usr/local/lib/ -L/usr/lib/ -Wl,--start-group -larrow -lparquet -lthrift -larrow_bundled_dependencies -lz -llmdb -lrt -lalign_format -lbiblio -lblast -lblastdb -lblastdb_format -lblastinput -lblast_services -lcomposition_adjustment -lconnect -lct_ftds14 -ldbapi_driver -lefetch -legquery -lehistory -leinfo -lelink -lepost -lesearch -lespell -lesummary -leutils -lgeneral -lgenome_collection -lid1 -lid2 -lmedline -lncbi_xdbapi_ftds -lncbi_xloader_blastdb -lncbi_xloader_blastdb_rmt -lncbi_xloader_genbank -lncbi_xreader -lncbi_xreader_cache -lncbi_xreader_id1 -lncbi_xreader_id2 -lpub -lpubmed -lQuickBLASTcpp -lscoremat -lseq -lseqcode -lseqdb -lseqedit -lseqmasks_io -lseqset -lseqsplit -lsequtil -lsqlitewrapp -lsubmit -ltables -ltaxon1 -ltaxon3 -ltds_ftds14 -luilist -lutrtprof -lvalid -lwritedb -lxalgoalignutil -lxalgoblastdbindex -lxalgodustmask -lxalgoseq -lxalgowinmask -lxalnmgr -lxblast -lxcgi -lxcleanup -lxcompress -lxconnect -lxflatfile -lxhtml -lxlogging -lxncbi -lxnetblast -lxnetblastcli -lxobjedit -lxobjmgr -lxobjread -lxobjsimple -lxobjutil -lxqueryparse -lxregexp -lxser -lxutil -lzcf -Wl,--end-group

PKG_CXXFLAGS = -include include/rcpp_workaround.hpp -O3 -Ilibsrc $(SHLIB_OPENMP_CXXFLAGS) $(TOOLKIT_CPPFLAGS) -pthread -I/usr/local/src/ -I/usr/include/ -Isrc/include/ -I../BUILD/arrow/cpp/src/ -I../BUILD/arrow/cpp/BUILD/src/ -I../BUILD/ncbi-cxx-toolkit-public/include/ -I../BUILD/ncbi-cxx-toolkit-public/src/ -I../BUILD/ncbi-cxx-toolkit-public/BUILD/inc/

all: builddeps $(SHLIB) copy_lib post_build_cleanup
$(SHLIB): install_libs 

# Resolve R package dependencies within the recipe context using standard POSIX shell backticks
builddeps:
	(rm -f *.o *.so ; \
	mkdir -p ../BUILD; \
	cd ../BUILD; \
	CC="$(CC)" CFLAGS="$(CFLAGS)" \
	CPPFLAGS="$(CPPFLAGS)" LDFLAGS="$(LDFLAGS)" RTOOLS_DIR="" \
	cmake .. \
	-DCMAKE_BUILD_TYPE=Release \
	-DR_ARCH="$(R_ARCH)" \
	-DBUILD_SHARED_LIBS:bool=OFF \
	-DCMAKE_POSITION_INDEPENDENT_CODE:bool=ON \
	-DR_SHELL=1 \
	-DRTOOLS_DIR="" \
	-DTOOLKIT_CPPFLAGS="$(TOOLKIT_CPPFLAGS)" \
	-DRCPP_FOLDER="`"$(R_HOME)/bin/Rscript" -e "cat(system.file(package='Rcpp'))"`" \
	-DRCPPPROG_FOLDER="`"$(R_HOME)/bin/Rscript" -e "cat(system.file(package='RcppProgress'))"`" \
	-DRCPPTHREAD_FOLDER="`"$(R_HOME)/bin/Rscript" -e "cat(system.file(package='RcppThread'))"`" \
	-DR_INCLUDE_DIR="$(R_INCLUDE_DIR)" \
	-DCMAKE_EXPORT_NO_PACKAGE_REGISTRY=ON \
	-DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF \
	-DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF ; \
	$(MAKE))
	
install_libs:
	(mkdir -p ../inst/libs/$(R_ARCH) ; \
	cd ../BUILD/ncbi-cxx-toolkit-public/BUILD/lib/ ; \
	cd ../bin ; \
	cp -uf makeblastdb ../../../../inst/libs/$(R_ARCH)/ ; \
	echo $(R_ARCH) ; \
	)

copy_lib:
	strip -S *.so && cp -uf *.so ../inst/libs/$(R_ARCH) ; 
	
post_build_cleanup:
	rm -rf ../BUILD;
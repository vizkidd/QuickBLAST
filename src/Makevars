builddeps:
	(rm -f *.o *.so ; \
	mkdir ../BUILD; \
	cd ../BUILD; \
	CC="$(CC)" CFLAGS="$(CFLAGS)" \
	CPPFLAGS="$(CPPFLAGS)" LDFLAGS="$(LDFLAGS)" RTOOLS_DIR="" \
	cmake .. \
	-DCMAKE_BUILD_TYPE=Release \
	-DBUILD_SHARED_LIBS:bool=OFF \
	-DCMAKE_POSITION_INDEPENDENT_CODE:bool=ON \
	-DR_SHELL=1 \
	-DRTOOLS_DIR="" \
	-DTOOLKIT_CPPFLAGS=$(TOOLKIT_CPPFLAGS) \
	-DRCPP_FOLDER="$(RCPP_FOLDER)" \
	-DRCPPPROG_FOLDER="$(RCPPPROG_FOLDER)" \
	-DRCPPTHREAD_FOLDER="$(RCPPTHREAD_FOLDER)"; \
	$(MAKE))
	
build_patchelf:
	(cd ../BUILD/patchelf ; \
	./bootstrap.sh ; \
	./configure ; \
	$(MAKE) ; \
	#$(MAKE) check ; \
	)
	
install_libs:
	(mkdir -p ../inst/libs/$(R_ARCH) ; \
	cd ../BUILD/ncbi-cxx-toolkit-public/BUILD/lib/ ; \
	cp -uf *.so ../../../../inst/libs/$(R_ARCH)/ ; \
	cd ../bin ; \
	cp -uf makeblastdb ../../../../inst/libs/$(R_ARCH)/ ; \
	cd ../../../arrow/cpp/BUILD/release/ ; \
	cp -uf *.so* ../../../../../inst/libs/$(R_ARCH)/ ; \
	cd ../../../../../src; \
	echo $(R_ARCH) ; \
	)

copy_lib:
		cp -uf *.so ../inst/libs/$(R_ARCH) ; 
	
fix-rpath:
	@cd ../ ; \
	find "inst/libs" -type f -iname '*.so*' -or -type f -iname "makeblastdb" | \
		while IFS= read -r -d $$'\n' f; do \
			echo "patching $$f"; \
			$(PATCHELF) --set-rpath '$$ORIGIN' "$$f"; \
			strip -S "$$f"; \
		done
		

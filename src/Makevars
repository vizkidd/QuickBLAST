builddeps:
	(rm -f *.o *.so ; \
	mkdir ../BUILD; \
	cd ../BUILD; \
	CC="$(CC)" CFLAGS="$(CFLAGS)" \
	CPPFLAGS="$(CPPFLAGS)" LDFLAGS="$(LDFLAGS)" RTOOLS_DIR="" \
	cmake .. \
	-DCMAKE_BUILD_TYPE=Release \
	-DBUILD_SHARED_LIBS:bool=OFF \
	-DCMAKE_POSITION_INDEPENDENT_CODE:bool=ON \
	-DR_SHELL=1 \
	-DRTOOLS_DIR=""; \
	$(MAKE))
	
build_patchelf:
	(cd ../BUILD/patchelf ; \
	./bootstrap.sh ; \
	./configure ; \
	$(MAKE) ; \
	$(MAKE) check ; \
	)
	
install_libs:
	(mkdir -p ../inst/libs/$(R_ARCH) ; \
	cd ../BUILD/ncbi-cxx-toolkit-public/BUILD/lib/ ; \
	cp -uf *.so ../../../../inst/libs/$(R_ARCH)/ ; \
	cd ../../../arrow/cpp/BUILD/release/ ; \
	cp -uf *.so* ../../../../../inst/libs/$(R_ARCH)/ ; \
	cd ../../../../../src; \
	echo $(R_ARCH) ; \
	)

copy_lib:
		cp -uf *.so ../inst/libs/$(R_ARCH) ; 
	
fix-rpath:
	@cd ../ ; command -v $(PATCHELF) >/dev/null 2>&1 || { echo "patchelf not found; install it or set PATCHELF variable"; exit 1; }
	@echo "Patching rpath to '\$$ORIGIN' for .so files under inst/libs"
	@cd ../ ; \
	find "inst/libs" -type f -name '*.so*' -print0 | \
		while IFS= read -r -d $$'\0' f; do \
			echo "patching $$f"; \
			$(PATCHELF) --set-rpath '$$ORIGIN' "$$f"; \
		done
		

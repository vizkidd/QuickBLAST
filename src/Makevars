CXXSTD = CXX17

# Adjust these paths based on where Make is executed. 
# Assuming Make runs in src/, so we step back to the package root.
PKG_ROOT = ..
MAIN_LIB = src/QuickBLAST.so
LIB_DIR = inst/libs

PATCHELF ?= BUILD/patchelf/src/patchelf   # fallback if patchelf not in PATH

#LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libasan.so.8
